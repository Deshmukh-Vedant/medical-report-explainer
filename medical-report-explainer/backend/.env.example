# Copy this file to ".env" in the backend/ folder and fill in real values.
# NEVER commit your actual .env file with real secrets to version control.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=sqlite:///./medical_reports.db

MAX_UPLOAD_MB=20

# --- Password Reset ---
RESET_TOKEN_EXPIRE_MINUTES=30
APP_BASE_URL=http://localhost:5500

# --- Email (SMTP) ---
# Leave blank for console-only mode (development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@medexplain.ai
